{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "crons": [
    { "path": "/api/keepalive?run=midnight", "schedule": "0 0 * * *" },
    { "path": "/api/keepalive?run=noon", "schedule": "0 12 * * *" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/(.*\\.(css|js|png|jpg|ico|svg|woff2?|html))", "dest": "public/$1" },
    { "src": "/(.*)", "dest": "public/index.html" }
  ]
}
